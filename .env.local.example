# =============================================================================
# OpenMAIC — LDAP accounts + server-managed AI keys
#
# Copy this file to .env.local and fill the values marked <...>.
# .env.local is gitignored; never commit real keys or directory passwords.
#
# The matching openmaic.yml template is openmaic.server-managed.example.yml:
# copy it to openmaic.yml (also gitignored). It fixes every model slot and
# turns off user-provided keys, so the web UI has no model configuration.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Required. `pnpm db:up` starts the development PostgreSQL on this URL.
DATABASE_URL=postgres://openmaic:openmaic-dev@127.0.0.1:5432/openmaic

# --- AI provider (server-side only) ------------------------------------------
# The key lives here; the browser never receives it. openmaic.yml references
# it as ${OPENAI_API_KEY}. Keep *_MODELS when the provider is a gateway with
# an explicit allow-list; leave it empty for the official endpoint.
OPENAI_API_KEY=<paste-your-provider-key>
OPENAI_BASE_URL=
OPENAI_MODELS=

# Seal provider keys that a user might save through the web settings. Even
# with allowUserKeys: false, set it so a later settings change cannot corrupt
# stored values. Generate one: openssl rand -base64 32
OPENMAIC_SECRET_KEY=<paste-a-long-random-secret>

# --- LDAP accounts (one course library per directory user) -------------------
# Turn this on only after every LDAP_* value below is filled. When it is true
# the deployment refuses to start with an incomplete LDAP configuration.
# This flag is also read by the Edge middleware in a production build, where it
# is baked in: set it before `pnpm build`, and rebuild when you change it.
NEXT_PUBLIC_LDAP_ENABLED=false

# ldaps:// is recommended. If your directory only offers ldap://, set
# LDAP_STARTTLS=true and use a CA-trusted certificate.
LDAP_URL=ldaps://ldap.example.com:636
LDAP_STARTTLS=false

# Escape hatch for a directory that offers neither LDAPS nor StartTLS (an
# on-premise AD with TLS disabled, for example). The bind password then
# travels in clear text on that hop. The server logs a warning; only set this
# on a network you already trust.
LDAP_ALLOW_INSECURE=false

# Read-only service account used to find the user entry. Leave both empty only
# if your directory allows anonymous searches (rare and usually a bad idea).
LDAP_BIND_DN=cn=openmaic,ou=services,dc=example,dc=com
LDAP_BIND_PASSWORD=<paste-the-service-account-password>

# Where users live and how a login name finds exactly one entry.
LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
LDAP_USER_FILTER=(uid={username})

# Stable per-user id. The owner id is derived from it, so changing it later
# strands that user's existing library.
#   OpenLDAP / FreeIPA : entryUUID
#   Active Directory   : objectGUID   (filter: (sAMAccountName={username}))
LDAP_USER_ID_ATTRIBUTE=entryUUID
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName

LDAP_TIMEOUT_MS=5000

# Signs the HttpOnly session cookie. At least 16 characters; generate one:
#   openssl rand -base64 32
LDAP_SESSION_SECRET=<paste-a-long-random-secret>

# 7 days, renewed while the user is active (300 .. 2592000).
LDAP_SESSION_TTL_SECONDS=604800

# With accounts, page responses must not mint a per-browser anonymous owner:
# it would never serve a request and, with OWNER_CLAIM_TRIGGER=auto, would be
# claimed and cleared after every cookieless page load.
OWNER_ANONYMOUS_PREMINT=false

# Optional: bring a browser's pre-login anonymous library into the account on
# its first authenticated request. Default is explicit (the app can call
# POST /api/identity/claim). Read the warning in packages/docs/content/docs/
# hosting.mdx#single-user-mode before enabling it.
# OWNER_CLAIM_TRIGGER=auto

# --- Optional site-wide password --------------------------------------------
# An additional gate in front of LDAP. Leave unset when LDAP is the only gate.
# ACCESS_CODE=

# --- Do not set --------------------------------------------------------------
# These select single-owner modes and conflict with LDAP registration:
#   OWNER_SINGLE_USER=true
#   PERSISTENCE_SHARED_OWNER_ID=<id>
